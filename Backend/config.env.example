# Email Providers (tried in order: Resend -> Brevo -> SMTP/Gmail -> SendGrid)
# Option 1 (Recommended for Render/Cloud - HTTPS API, 300 free emails/day):
# BREVO_API_KEY=xkeysib-your_brevo_api_key
# BREVO_FROM_EMAIL=your_verified_sender@gmail.com

# Option 2 (HTTPS API - 100 free emails/day):
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=Trackon <onboarding@resend.dev>

# Option 3 (Gmail SMTP with 16-character Google App Password from https://myaccount.google.com/apppasswords):
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_character_google_app_password

# Option 4 (Custom SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
# SMTP_FROM=your_email@gmail.com

# Option 5 (SendGrid):
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_email@example.com

# Frontend URL for Password Reset Links
FRONTEND_URL=https://trackon.netlify.app

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=90d

DBURI=mongodb+srv://<username>:<DBPASSWORD>@cluster0.mongodb.net/?appName=Cluster0
DBPASSWORD=your_db_password
PORT=5000

ZEGO_APP_ID=your_zego_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=chat-media
